  forestText: "\u7B2C\u4E00\u95DC:\u68EE\u6797\n\u7528\u820C\u982D\u5403\u8449\u5B50\u4E0A\u7684\u6C34\u73E0\n\u6C34\u5206
    {0} / {1}"
  goToCaveText: "\u6C34\u5206\u8DB3\u5920\u4E86!\n\u524D\u5F80\u5834\u666F\u4E2D\u592E\u7684\u6D1E\u7A74"
  caveText: "\u7B2C\u4E8C\u95DC:\u5730\u6D1E\n\u7528\u820C\u982D\u54AC\u4E0B\u7926\u77F3\n\u7926\u77F3\u80FD\u91CF
    {0} / {1}"
  goToExitText: "\u7926\u77F3\u6536\u96C6\u5B8C\u6210!\n\u5F9E\u51FA\u53E3\u96E2\u958B\u6D1E\u7A74"
  finishedText: "\u6210\u529F\u96E2\u958B\u5730\u6D1E!"
  blockedCaveText: "\u6C34\u5206\u4E0D\u5920,\u9084\u4E0D\u80FD\u9032\u5165\u6D1E\u7A74"
  blockedLeaveText: "\u7926\u77F3\u9084\u6C92\u6536\u96C6\u5B8C,\u4E0D\u80FD\u96E2\u958B"
  blockedForestText: "\u8D85\u51FA\u68EE\u6797\u7BC4\u570D\u4E86"
  useEntranceText: "\u8981\u5F9E\u5730\u6D1E\u51FA\u5165\u53E3\u9032\u51FA"
  sideFloorText: "\u9019\u88E1\u904E\u4E0D\u53BB,\u8981\u8DF3\u77F3\u982D\u904E\u53BB"
  gameOverText: "\u6389\u9032\u6DF1\u6DF5\u4E86\u2026\u2026\n\u904A\u6232\u7D50\u675F\n\u6309\u53F3\u624B
    A \u91CD\u65B0\u958B\u59CB"
  statusFormat: "\u6BD2\u7D20 {0}   \u6C34\u5206 {1}   \u7926\u77F3 {2}"
